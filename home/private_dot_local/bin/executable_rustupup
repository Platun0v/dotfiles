#!/usr/bin/env fish

if not command -q rustup
  set_color red
  echo "Installing rustup..."
  set_color normal

  curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain none
  set -p PATH $CARGO_HOME/bin
else
  set_color red
  echo "Updating rustup..."
  set_color normal

  rustup self update
end

for toolchain in stable
  if rustup toolchain list | string match -rq "^$toolchain"
    set_color red
    echo "Updating $toolchain Rust toolchain..."
    set_color normal

    rustup update --no-self-update $toolchain
  else
    set_color red
    echo "Installing $toolchain Rust toolchain..."
    set_color normal

    rustup toolchain install $toolchain
  end
end

set installed (cargo install --list | string match -r '^\S+')

set wanted $(chezmoi data | yq '.rust.wanted[]')
set wanted_git $(chezmoi data | yq '.rust.wanted-git[]')

for crate in $wanted
  if contains -- $crate $installed
    set i (contains -i -- $crate $wanted)
    set -e wanted[$i]
  end
end

if test (count $wanted) -gt 0
  set_color red
  echo "Installing crates..."
  set_color normal

  cargo install --locked --force -- $wanted
end

for git_repo in $wanted_git
  # Извлечение имени крейта из пути GitHub
  set crate_name (string split / $git_repo | tail -n 1)
  
  if contains -- $crate_name $installed
    set_color yellow
    echo "Updating git crate: $crate_name from $git_repo"
    set_color normal
    cargo install --force --git "https://github.com/$git_repo"
  else
    set_color red
    echo "Installing git crate: $crate_name from $git_repo"
    set_color normal
    cargo install --git "https://github.com/$git_repo"
  end
end

if test (count $installed) -gt 0
  set_color red
  echo "Updating crates..."
  set_color normal

  cargo install-update -- $installed
end
