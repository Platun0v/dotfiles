{{/* os environment detection */}}
{{- $osid := .chezmoi.os -}}
{{- if .chezmoi.osRelease -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{/* Some machine dependant vars */}}
{{- $email  := "me@platun0v.ru" -}}{{/* Users mail, used in gitconfig */}}
{{- $name := "platun0v" -}}{{/* Name of user, used in gitconfig */}}
{{- $work := false -}}{{/* work machine: gates corporate (encrypted) git config */}}

{{- if hasKey . "configured" -}}
{{-   $email  = .email -}}
{{-   $name = .name -}}
{{-   if hasKey . "work" -}}{{- $work = .work -}}{{- end -}}
{{- else -}}
{{-   if and (not $email) stdinIsATTY -}}
{{-     $email := promptStringOnce . "email" "What is your email address" }}
{{-   end -}}
{{-   if and (not $name) stdinIsATTY -}}
{{-     $name := promptStringOnce . "name" "What is your name address" }}
{{-   end -}}
{{-   if stdinIsATTY -}}
{{-     $work = promptBoolOnce . "work" "Is this a work machine (enables corporate git config)" -}}
{{-   end -}}
{{- end -}}

encryption = "age"

[age]
    identity = {{ (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt") | quote }}
    recipient = "age1lrrgngkw5q2c4z6ag3vgs2xaxkp2shfx6d4sxjkqnzfry6fsmp6s5lr3ya"

{{ if stat (joinPath .chezmoi.workingTree ".jj") -}}
# Source dir is a colocated jj repo: jj keeps git HEAD permanently detached, so
# chezmoi's default `git pull --autostash --rebase` dies with "You are not
# currently on a branch". Fetch and rebase the working-copy branch with jj
# instead (no autostash needed — the working copy is itself a commit).
[update]
    command = "sh"
    args = ["-c", "jj git fetch && jj rebase -o master@origin"]

{{ end -}}
[data]
    configured = true

    osid       = {{ quote $osid }}
    email      = {{ quote $email }}
    name       = {{ quote $name }}
    work       = {{ $work }}
