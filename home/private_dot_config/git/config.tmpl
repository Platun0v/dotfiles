[init]
	defaultBranch = master
[core]
	editor = vim
	autocrlf = input
[user]
	email = {{ .email | quote }}
	name = {{ .name | title }}
[url "ssh://git@git.platun0v.ru"]
	insteadOf = "https://git.platun0v.ru"
{{ if get . "work" -}}
{{ (joinPath .chezmoi.sourceDir ".secrets/git_work_urls.age") | include | decrypt | trim }}
{{ end -}}
[pull]
	ff = true
	rebase = true
[push]
	default = current
[rebase]
	autoSquash = true
	autoStash = true
	stat = true
	updateRefs = true
[status]
	short = true
	branch = true
	showStash = true
	submoduleSummary = true
[alias]
	count-lines = "! git log --author=\"$1\" --pretty=tformat: --numstat | awk '{ add += $1; subs += $2; loc += $1 - $2 } END { printf \"added lines: %s, removed lines: %s, total lines: %s\\n\", add, subs, loc }' #"