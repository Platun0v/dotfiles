{{- if or .python.uvx .python.uvx_with -}}
#!/bin/sh

# Import formatting library
source "{{ .chezmoi.sourceDir }}/utils-unix/formatting.sh"

# Pin the interpreter so tools don't land on a too-new Python that lacks wheels.
# uv downloads a managed CPython for this version if the system doesn't have it.
python_version="3.13"

total={{ add (len .python.uvx) (len .python.uvx_with) }}
count=0
failed=0

# install_tool <display-name> <uv tool install args...>
install_tool() {
    name="$1"
    shift
    count=$((count + 1))
    print_progress "$count" "$total" "Installing: $name"
    # NOTE: intentionally no `set -e` — we keep installing the rest even if one
    # fails. Capture combined output so a clean run stays quiet, but on failure
    # print uv's actual error (which --quiet would otherwise hide).
    if output=$(uv tool install "$@" --python "$python_version" --force 2>&1); then
        print_success "Successfully installed $name via uvx"
    else
        print_warning "Failed to install $name via uvx"
        printf '%s\n' "$output" | sed 's/^/    /'
        failed=$((failed + 1))
    fi
}

print_info "Installing $total applications via uvx (Python $python_version)..."

# Simple tools: one isolated environment each.
{{ range $pkg := .python.uvx -}}
install_tool "{{ $pkg }}" "{{ $pkg }}"
{{ end -}}
# Tools needing extra packages in the same environment (uv tool install --with).
{{ range $t := .python.uvx_with -}}
install_tool "{{ $t.package }}" "{{ $t.package }}"{{ range $w := $t.with }} --with "{{ $w }}"{{ end }}
{{ end -}}

if [ "$failed" -gt 0 ]; then
    print_warning "$failed package(s) failed to install"
fi
{{- end -}}
