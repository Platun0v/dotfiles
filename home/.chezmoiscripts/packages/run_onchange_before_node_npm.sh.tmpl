{{- if .node.npm -}}
#!/bin/sh -e

# Import formatting library
source "{{ .chezmoi.sourceDir }}/utils-unix/formatting.sh"

packages=(
{{- range $pkg := .node.npm }}
    "{{ $pkg }}"
{{- end }}
)

print_info "Installing ${#packages[@]} global npm packages..."

for i in "${!packages[@]}"; do
    pkg="${packages[$i]}"
    print_progress $((i+1)) ${#packages[@]} "Installing: $pkg"
    if npm install -g "$pkg" --silent; then
        print_success "Successfully installed $pkg via npm"
    else
        print_warning "Failed to install $pkg via npm"
    fi
done
{{- end -}}
