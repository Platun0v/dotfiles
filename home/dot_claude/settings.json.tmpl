{
  "env": {
    "ANTHROPIC_BASE_URL": "{{ (joinPath .chezmoi.sourceDir ".secrets/base_url.age") | include | decrypt | trim }}",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "UV_SYSTEM_CERTS": "true"
  },
  "skipWebFetchPreflight": true,
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "WebSearch",
      "WebFetch",
      "mcp__plugin_mcp-stack_codegraph"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Write(**/.env.*)",
      "Edit(**/.env.*)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ]
  },
  "model": "claude-opus-5[1m]",
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "serena-hooks remind --client=claude-code" }
        ]
      },
      {
        "matcher": "mcp__plugin_mcp-stack_serena__*",
        "hooks": [
          { "type": "command", "command": "serena-hooks auto-approve --client=claude-code" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "f=$(ls -dt \"$HOME/.claude/plugins/cache/jj-workflow/jj-workflow\"/*/skills/jj-concepts/SKILL.md 2>/dev/null | head -1); [ -n \"$f\" ] && jq -n --rawfile content \"$f\" '{hookSpecificOutput: {hookEventName: \"SessionStart\", additionalContext: $content}}' || true" }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "serena-hooks activate --client=claude-code" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "serena-hooks cleanup --client=claude-code" }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "jj-workflow@jj-workflow": true,
    "data-tools@netresearch-claude-code-marketplace": true,
    "enforcement@platun0v-tools": true,
    "mcp-stack@platun0v-tools": true,
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "jj-workflow": { "source": { "source": "github", "repo": "kalupa/jj-workflow" } },
    "netresearch-claude-code-marketplace": { "source": { "source": "github", "repo": "netresearch/claude-code-marketplace" } },
    "platun0v-tools": { "source": { "source": "github", "repo": "platun0v/dotfiles" } },
    "mattpocock": { "source": { "source": "github", "repo": "mattpocock/skills" } }
  }
}
